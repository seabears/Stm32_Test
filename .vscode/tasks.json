{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "STM32: Build",
      "type": "shell",
      "command": "${workspaceFolder}\\build.cmd",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "STM32: Flash",
      "type": "shell",
      "command": "${workspaceFolder}\\build.cmd",
      "args": [
        "flash"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOrder": "sequence",
      "dependsOn": [
        "STM32: Build"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
