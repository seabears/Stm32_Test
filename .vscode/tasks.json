{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "STM32: Build",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/Tools/build.ps1",
        "-Target",
        "all"
      ],
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "STM32: Clean",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/Tools/build.ps1",
        "-Target",
        "clean"
      ],
      "problemMatcher": "$gcc"
    },
    {
      "label": "STM32: Flash [STLink]",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/Tools/build.ps1",
        "-Target",
        "flash"
      ],
      "problemMatcher": "$gcc"
    }
  ]
}
